# Web Phase 7C — Lead Intake
# Direct lead submission remains disabled unless BOTH required URLs are valid.

# Required to enable direct lead delivery.
# For the Brevo destination foundation, this will eventually point to:
# https://iaempleado.com/api/internal/lead-destinations/brevo
LEAD_INTAKE_WEBHOOK_URL=

# Required to enable direct lead delivery. Must point to the published privacy notice.
LEAD_PRIVACY_NOTICE_URL=

# Shared server-to-server bearer token.
# Used by /api/lead-intake when calling the protected downstream destination.
LEAD_INTAKE_WEBHOOK_TOKEN=

# Web Phase 7C2A — Brevo commercial destination
# Keep all values server-side. Never expose them through NEXT_PUBLIC_* variables.
BREVO_API_KEY=
BREVO_PIPELINE_ID=
BREVO_DEAL_STAGE_ID=

# Optional Brevo account email or user ID used as deal_owner.
BREVO_DEAL_OWNER=
