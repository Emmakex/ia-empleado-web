# IA Empleado Web — server environment template
# Never commit real credentials. Production secrets belong in the deployment environment.

# Canonical commercial website URL.
APP_BASE_URL=https://iaempleado.com

# Web Phase 7C1 — existing provider-agnostic Lead Intake transport.
# Direct webhook submission remains disabled unless BOTH required URLs are valid.
# These variables stay part of the verified 7C1 contract while 7C2 SMTP delivery is implemented.

# Required to enable the existing webhook delivery mode.
LEAD_INTAKE_WEBHOOK_URL=

# Required for direct lead handling. Must point to the published privacy notice.
LEAD_PRIVACY_NOTICE_URL=

# Optional bearer token sent only from the server to the configured webhook.
LEAD_INTAKE_WEBHOOK_TOKEN=

# Web Phase 7C2 — iaempleado.com commercial email delivery via Hostinger SMTP.
# Hostinger default SMTP: smtp.hostinger.com with SSL on port 465.
# If the deployment requires STARTTLS instead, use port 587 and SMTP_SECURE=false.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Sender identity. Keep FROM on the iaempleado.com domain.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IA Empleado

# Internal commercial destination for qualified leads.
LEAD_NOTIFICATION_TO=

# Optional subject prefix to make lead notifications easy to filter.
LEAD_NOTIFICATION_SUBJECT_PREFIX=[IA Empleado]
